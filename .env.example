# =====================================================================
# Venkat Sai Travels - Production Environment Template (.env.example)
# DO NOT commit actual secrets or production passwords to version control!
# =====================================================================

# 1. PostgreSQL Database Connection (Remote Production Server)
DB_CONNECTION=pgsql
DB_HOST=168.119.64.101
DB_PORT=5432
DB_DATABASE=venka941
DB_USERNAME=venka941
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# Optional Unified Connection URI:
DATABASE_URL=postgres://venka941:YOUR_SECURE_DB_PASSWORD_HERE@168.119.64.101:5432/venka941

# PostgreSQL SSL/TLS Mode:
# Options: 'disable' | 'require' | 'verify-ca' | 'verify-full'
# When the hosting server enables SSL in postgresql.conf, set to 'verify-full' or 'require'.
# If using self-signed or private CA, supply DB_SSL_CA path.
DB_SSLMODE=disable
# DB_SSL_CA=/path/to/server-ca.crt
# DB_SSL_SERVERNAME=your-db-hostname.domain.com

# Connection Pool Settings
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000

# 2. Server Runtime Configuration
PORT=3000
# Note: NODE_ENV is set automatically by PM2 (ecosystem.config.js)


# 3. Allowed Browser Origins (CSRF Protection)
APP_ORIGIN=https://venkatsai.roiclients.co.in, https://www.venkatsaitravels.com, https://venkatsaitravels.com

# 4. Cookie Configuration
# Set 'true' in production with HTTPS (uses Secure and HttpOnly flags)
COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# 5. Reverse Proxy Security
# Set 'true' when running behind Nginx / Cloudflare
TRUST_PROXY=true
ALLOW_PASSWORD_RESET=false
