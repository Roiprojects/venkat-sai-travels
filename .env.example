# PostgreSQL Database connection
DATABASE_URL=postgres://user:password@127.0.0.1:5432/database_name

# Or individual PG parameters:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=database_name
# PGUSER=user
# PGPASSWORD=password

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# Allowed browser origins for CSRF protection (comma-separated, no trailing slash)
APP_ORIGIN=https://venkatsai.roiclients.co.in

# Cookie configuration
# In production with HTTPS, cookies are set as Secure (__Host- prefix)
COOKIE_SECURE=true

# Session TTL in days (default: 7)
SESSION_TTL_DAYS=7

# Enable password reset endpoint (default: false for security)
ALLOW_PASSWORD_RESET=false

# Trust proxy headers when deployed behind Nginx (default: false)
TRUST_PROXY=true
