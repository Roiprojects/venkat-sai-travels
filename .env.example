# =====================================================================
# Venkat Sai Travels - Production Environment Configuration
# =====================================================================

# 1. PostgreSQL Database Connection
# Format: postgres://<user>:<password>@<host>:<port>/<database_name>
# For cloud databases (Supabase, Neon, AWS, Render), append ?sslmode=require
DATABASE_URL=postgres://user:password@127.0.0.1:5432/venka941

# Optional discrete parameters if not using DATABASE_URL:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=venka941
# PGUSER=user
# PGPASSWORD=password
# PG_POOL_MAX=10
# Set to 'true' if using cloud-managed DB with SSL (e.g. Supabase, Neon, Render, AWS RDS)
DATABASE_SSL=false

# 2. Server Runtime Configuration
PORT=3000
# Note: NODE_ENV is set automatically by PM2 (ecosystem.config.js) and vite build.
# Do not specify NODE_ENV=production here to avoid Vite build conflicts.

# 3. Allowed Browser Origins (CSRF Protection)
# Supports:
#  - Comma-separated list: e.g. https://venkatsaitravels.com, https://www.venkatsaitravels.com, https://subdomain.yourdomain.com
#  - Wildcard for testing: *
#  - If left blank, the server automatically allows requests matching the current Host (same-origin & subdomains)
APP_ORIGIN=https://venkatsai.roiclients.co.in, https://www.venkatsaitravels.com, https://venkatsaitravels.com

# 4. Cookie Configuration
# Set to 'true' in production with HTTPS (uses __Host-vst_session with Secure & HttpOnly flags)
# Set to 'false' if testing over plain HTTP without SSL
COOKIE_SECURE=true

# Session lifetime in days (default: 7)
SESSION_TTL_DAYS=7

# 5. Reverse Proxy & Security
# Set 'true' when deployed behind Nginx, Apache, Cloudflare, or Traefik
TRUST_PROXY=true

# Allow admin password reset endpoint (default: false for security)
ALLOW_PASSWORD_RESET=false
